# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Meta Model API — claim $150 credits via the participant guide form (deadline Nov 4, 9 PM ET)
# No code reads this name; the credential the code authorizes with is MODEL_API_KEY below.
META_API_KEY=

# Meta Model API rail (https://api.meta.ai/v1, OpenAI-compatible) — the key
# the app and scripts/meta_smoke_test.py authorize with. Obtain access + credits
# via the hackathon participant guide form (same program as META_API_KEY above).
MODEL_API_KEY=

# ElevenLabs API key — spoken replies (TTS). Optional: without it the
# conversation UI falls back to browser speechSynthesis and shows a visible
# built-in-voice notice. Replaced Gemini TTS (HACK-116, 2026-10-31: the
# Gemini free tier allowed 10 requests/DAY and silently degraded).
# Obtain at https://elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=

# Optional TTS overrides (empty = the committed constants in src/lib/tts.ts):
# the model behind the speak route, and the voice it speaks with (the VOICE
# ID — the path does not accept display names). Shipped choice:
# eleven_multilingual_v2 (quality) + "Sarah" (EXAVITQu4vr4xnSDxMaL) — see
# the tts-elevenlabs-switch PR for the recorded choice.
ELEVENLABS_TTS_MODEL=
ELEVENLABS_TTS_VOICE=

# Baseten — mind the model-name trap: meta-models/muse-spark-open-1026
BASETEN_API_KEY=

# Modal — spare GPU credits (no current build stage uses it; reserved)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Fireworks — $25, shortlisted teams only
FIREWORKS_API_KEY=

# App (when it exists)
NEXT_PUBLIC_APP_URL=

# Benefits Navigator app runtime (Next.js, see AGENTS.md § App commands)
# Postgres connection string for the benefits data model (BN-02)
# e.g. postgresql://user:password@localhost:5432/benefits_navigator
DATABASE_URL=

# AES-256 key for the PII vault (vault_entry values are encrypted at rest).
# Generate with: openssl rand -hex 32. WITHOUT IT the vault FAILS CLOSED:
# pii answers cannot be saved or read (there is no plaintext fallback).
# Never log, echo, or commit this value.
VAULT_ENC_KEY=

# Claude PR review bot (CI only). The claude-review workflow reads this from
# the ANTHROPIC_REVIEW_KEY repo secret; no local code needs it, and dry runs
# (python3 scripts/claude_review.py --dry-run ...) work without it. Use a key
# from an Anthropic Console workspace that has a monthly spend limit.
ANTHROPIC_REVIEW_KEY=
